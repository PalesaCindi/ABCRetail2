@model ABCRetail.Models.Order

@{
    ViewData["Title"] = "Order Processing";
}

<div class="container py-4">

    <div class="row">
        <div class="col-md-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">
                        <div class="display-6 me-3">📦</div>

                        <div>
                            <h1 class="mb-1">Order Processing</h1>

                            <p class="text-muted mb-0">
                                Orders are processed through Azure Queue Storage.
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="alert alert-info">
                        <strong>Azure Queue Storage</strong>
                        <br />
                        Orders are submitted to the
                        <strong>order-processing</strong> queue
                        for reliable asynchronous processing.
                    </div>

                    <dl class="row mt-4">

                        <dt class="col-sm-4">
                            Customer ID
                        </dt>

                        <dd class="col-sm-8">
                            @Model?.CustomerId
                        </dd>

                        <dt class="col-sm-4">
                            Product ID
                        </dt>

                        <dd class="col-sm-8">
                            @Model?.ProductId
                        </dd>

                        <dt class="col-sm-4">
                            Quantity
                        </dt>

                        <dd class="col-sm-8">
                            @Model?.Quantity
                        </dd>

                        <dt class="col-sm-4">
                            Total Amount
                        </dt>

                        <dd class="col-sm-8">
                            @Model?.TotalAmount
                        </dd>

                        <dt class="col-sm-4">
                            Status
                        </dt>

                        <dd class="col-sm-8">
                            <span class="badge bg-warning text-dark">
                                @Model?.Status
                            </span>
                        </dd>

                        <dt class="col-sm-4">
                            Order Date
                        </dt>

                        <dd class="col-sm-8">
                            @Model?.OrderDate
                        </dd>

                    </dl>

                    <hr />

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to Orders
                    </a>

                </div>

            </div>

        </div>
    </div>

</div>