@model ABCRetail.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="display-6 me-3">
                            📦
                        </div>

                        <div>
                            <h1 class="mb-1">Create Order</h1>

                            <p class="text-muted mb-0">
                                Submit a new order for processing.
                            </p>
                        </div>

                    </div>

                    <hr />

                    <div class="alert alert-info">
                        <strong>Azure Queue Storage</strong>
                        <br />
                        This order will be sent to the
                        <strong>order-processing</strong> queue.
                    </div>

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Customer ID -->
                        <div class="mb-3">

                            <label asp-for="CustomerId"
                                   class="form-label fw-semibold">
                                Customer
                            </label>

                            <select asp-for="CustomerId"
                                    class="form-select">

                                <option value="">
                                    -- Select Customer --
                                </option>

                                @foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.Id">
                                        @customer.Name - @customer.Email
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CustomerId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Product ID -->
                        <div class="mb-3">

                            <label asp-for="ProductId"
                                   class="form-label fw-semibold">
                                Product
                            </label>

                            <select asp-for="ProductId"
                                    class="form-select">

                                <option value="">
                                    -- Select Product --
                                </option>

                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id">
                                        @product.ProductName - R @product.Price.ToString("N2")
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Quantity -->
                        <div class="mb-3">

                            <label asp-for="Quantity"
                                   class="form-label fw-semibold">
                                Quantity
                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter quantity" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Total Amount -->
                        <div class="mb-4">

                            <label asp-for="TotalAmount"
                                   class="form-label fw-semibold">
                                Total Amount
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    R
                                </span>

                                <input asp-for="TotalAmount"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="TotalAmount"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Create Order
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Back to Orders
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}