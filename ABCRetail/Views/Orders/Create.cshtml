@model ABCRetail.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="display-6 me-3">
                            📦
                        </div>

                        <div>
                            <h1 class="mb-1">Create Order</h1>

                            <p class="text-muted mb-0">
                                Submit a new order for processing.
                            </p>
                        </div>

                    </div>

                    <hr />

                    <div class="alert alert-info">
                        <strong>Azure Queue Storage</strong>
                        <br />
                        This order will be sent to the
                        <strong>order-processing</strong> queue.
                    </div>

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- CUSTOMER -->
                        <div class="mb-3">

                            <label asp-for="CustomerId"
                                   class="form-label fw-semibold">
                                Customer
                            </label>

                            <select asp-for="CustomerId"
                                    class="form-select">

                                <option value="">
                                    -- Select Customer --
                                </option>

                                @foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.Id">
                                        @customer.Name - @customer.Email
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CustomerId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PRODUCT -->
                        <div class="mb-3">

                            <label asp-for="ProductId"
                                   class="form-label fw-semibold">
                                Product
                            </label>

                            <select asp-for="ProductId"
                                    id="productSelect"
                                    class="form-select">

                                <option value=""
                                        data-price="0">
                                    -- Select Product --
                                </option>

                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id"
                                            data-price="@product.Price">
                                        @product.ProductName - R @product.Price.ToString("N2")
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- QUANTITY -->
                        <div class="mb-3">

                            <label asp-for="Quantity"
                                   class="form-label fw-semibold">
                                Quantity
                            </label>

                            <input asp-for="Quantity"
                                   id="quantityInput"
                                   type="number"
                                   min="1"
                                   value="1"
                                   class="form-control"
                                   placeholder="Enter quantity" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- UNIT PRICE -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Unit Price
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    R
                                </span>

                                <input type="text"
                                       id="unitPrice"
                                       class="form-control"
                                       value="0.00"
                                       readonly />

                            </div>

                        </div>


                        <!-- TOTAL AMOUNT -->
                        <div class="mb-4">

                            <label asp-for="TotalAmount"
                                   class="form-label fw-semibold">
                                Total Amount
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    R
                                </span>

                                <input asp-for="TotalAmount"
                                       id="totalAmount"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control"
                                       value="0.00"
                                       readonly />

                            </div>

                            <span asp-validation-for="TotalAmount"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Total Amount = Unit Price × Quantity
                            </small>

                        </div>


                        <!-- BUTTONS -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Create Order
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Back to Orders
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function calculateTotal() {

            const productSelect =
                document.getElementById("productSelect");

            const quantityInput =
                document.getElementById("quantityInput");

            const unitPriceInput =
                document.getElementById("unitPrice");

            const totalAmountInput =
                document.getElementById("totalAmount");


            // Get selected product
            const selectedOption =
                productSelect.options[
                    productSelect.selectedIndex
                ];


            // Get product price
            const price =
                parseFloat(
                    selectedOption.getAttribute("data-price")
                ) || 0;


            // Get quantity
            const quantity =
                parseInt(quantityInput.value) || 0;


            // Calculate total
            const total =
                price * quantity;


            // Display unit price
            unitPriceInput.value =
                price.toFixed(2);


            // Display total
            totalAmountInput.value =
                total.toFixed(2);
        }


        // Recalculate when product changes
        document
            .getElementById("productSelect")
            .addEventListener(
                "change",
                calculateTotal
            );


        // Recalculate when quantity changes
        document
            .getElementById("quantityInput")
            .addEventListener(
                "input",
                calculateTotal
            );


        // Calculate when page loads
        calculateTotal();

    </script>
}

