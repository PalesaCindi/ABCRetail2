@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="display-6 me-3">
                            📦
                        </div>

                        <div>
                            <h1 class="mb-1">Create Product</h1>

                            <p class="text-muted mb-0">
                                Add a new product to the ABC Retail system.
                            </p>
                        </div>

                    </div>

                    <hr />

                    <div class="alert alert-info">
                        <strong>Azure Storage</strong>
                        <br />
                        Product information will be stored in
                        <strong>Azure Table Storage</strong>.
                        Product images will be stored in
                        <strong>Azure Blob Storage</strong>.
                    </div>

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="ProductName"
                                   class="form-label fw-semibold">
                                Product Name
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="Enter product name" />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter product description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Price"
                                       class="form-label fw-semibold">
                                    Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        R
                                    </span>

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="0.00" />

                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Quantity"
                                       class="form-label fw-semibold">
                                    Quantity
                                </label>

                                <input asp-for="Quantity"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="Enter quantity" />

                                <span asp-validation-for="Quantity"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label for="image"
                                   class="form-label fw-semibold">
                                Product Image
                            </label>

                            <input type="file"
                                   id="image"
                                   name="image"
                                   class="form-control"
                                   accept="image/*" />

                            <div class="form-text">
                                Select an image to upload to Azure Blob Storage.
                            </div>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Create Product
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Back to Products
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}