@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="display-6 me-3">
                            ✏️
                        </div>

                        <div>
                            <h1 class="mb-1">Edit Product</h1>

                            <p class="text-muted mb-0">
                                Update the product information.
                            </p>
                        </div>

                    </div>

                    <hr />

                    <div class="alert alert-info">
                        <strong>Azure Storage</strong>
                        <br />
                        Product information is stored in
                        <strong>Azure Table Storage</strong>.
                    </div>

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Azure Table Storage identifier -->
                        <input type="hidden" asp-for="RowKey" />

                        <input type="hidden" asp-for="PartitionKey" />

                        <input type="hidden" asp-for="ETag" />

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">

                            <label asp-for="ProductName"
                                   class="form-label fw-semibold">
                                Product Name
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="Enter product name" />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter product description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Price"
                                       class="form-label fw-semibold">
                                    Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        R
                                    </span>

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Quantity"
                                       class="form-label fw-semibold">
                                    Quantity
                                </label>

                                <input asp-for="Quantity"
                                       type="number"
                                       min="0"
                                       class="form-control" />

                                <span asp-validation-for="Quantity"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Current Product Image
                                </label>

                                <div>
                                    <img src="@Model.ImageUrl"
                                         alt="@Model.ProductName"
                                         class="img-thumbnail"
                                         style="width:150px;height:120px;object-fit:cover;" />
                                </div>

                            </div>
                        }

                        <div class="mb-4">

                            <label for="image"
                                   class="form-label fw-semibold">
                                Replace Product Image
                            </label>

                            <input type="file"
                                   id="image"
                                   name="image"
                                   class="form-control"
                                   accept="image/*" />

                            <div class="form-text">
                                Leave this empty if you do not want to
                                replace the current image.
                            </div>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Back to Products
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}